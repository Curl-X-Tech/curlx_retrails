# ==============================================================================
# ReTrails Configuration (Team CurlX)
# ==============================================================================

# Project Name & Environment
PROJECT_NAME="ReTrails"
DOMAIN=localhost
ENVIRONMENT=local

# Security & Secrets
SECRET_KEY=changethis-secret-key-32-chars-long-security-token-fullstack-fastapi
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days
ALGORITHM=HS256

# First Superuser Initial Credentials
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis123

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retrails_db
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint

# Optional Direct Database URI (overrides individual POSTGRES_* params)
# DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/retrails_db

# Local development SQLite fallback (set to true to use SQLite instead of PostgreSQL)
USE_SQLITE=false
SQLITE_DB_PATH=./app.db

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","https://localhost","http://localhost:4173"]

# Email Configuration (Resend REST API)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=""
EMAILS_FROM_EMAIL=noreply@mail.curlx.tech
EMAILS_FROM_NAME="ReTrails"
FRONTEND_HOST=http://localhost:5173
EMAIL_RESET_TOKEN_EXPIRE_HOURS=24

# Rate Limiting Configuration
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=100

# Object Storage Configuration (MinIO / AWS S3 / Cloudflare R2)
STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=retrails-media
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend Public Env
VITE_API_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false
VITE_APP_NAME="ReTrails"
VITE_SIMULATED_DELAY_SEC=1

# Map Theming & Custom Tile API Key
# Default is Carto Positron (light minimal). If using MapTiler, Stadia, Mapbox, or custom provider, add key below:
VITE_MAP_API_KEY=""
# Example custom URL templates:
# MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key={apiKey}
# Stadia: https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key={apiKey}
# Carto Positron: https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png"

# Production & SSL Configuration (docker-compose.prod.yml)
DOMAIN_NAMES=curlx.tech www.curlx.tech
CERT_NAME=curlx.tech
DOCKER_IMAGE_REPO=curl-x-tech/curlx_retrails
IMAGE_TAG=latest

# pgAdmin (docker-compose.yml)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme


