# ==============================================================================
# ReTrails Configuration (Team CurlX)
# ==============================================================================

# Project Name & Domain
PROJECT_NAME="ReTrails"
DOMAIN=localhost
ENVIRONMENT=local

# Security & Secrets
SECRET_KEY=changethis-secret-key-32-chars-long-security-token-fullstack-fastapi
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days
ALGORITHM=HS256

# First Superuser
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis123

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis_postgres_pass

# For local development with SQLite fallback (leave empty to use PostgreSQL):
USE_SQLITE=false
SQLITE_DB_PATH=./app.db

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","https://localhost"]

# Email Configuration (SMTP / Mailpit for dev)
SMTP_TLS=false
SMTP_SSL=false
SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME="ReTrails"
FRONTEND_HOST=http://localhost:5173
EMAIL_RESET_TOKEN_EXPIRE_HOURS=24

# Rate Limiting Configuration
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=100

# Frontend Public Env
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME="ReTrails"
